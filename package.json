{
  "name": "dsh-settings-nav-organizer",
  "version": "1.7.2",
  "description": "Organize the DSH settings panel nav: fold third-party plugin entries under collapsible group rows, with bookmark-style custom groups and a fold toggle in General settings.",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    },
    "engines": {
      "dsh": ">=0.1.5-rc.1"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "settings",
    "sidebar",
    "nav",
    "fold",
    "ui"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhengjy01/dsh-settings-nav-organizer.git"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6 || ^0.1.1-rc.1 || ^0.1.2-alpha.1 || ^0.1.5-rc.1",
    "react": "^18.2.0"
  },
  "scripts": {
    "verify": "node scripts/portability.mjs --health /api/dsh-settings-nav-organizer/list",
    "verify:full": "node scripts/portability.mjs --health /api/dsh-settings-nav-organizer/list --stability 30",
    "verify:quick": "node scripts/portability.mjs --skip-audit --stability 5 --health /api/dsh-settings-nav-organizer/list",
    "release": "node scripts/release.mjs",
    "release:check": "node scripts/release.mjs --check"
  }
}
